# ═══════════════════════════════════════════════════════════════
# Falz Production Environment Variables (.env.production)
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env in your Coolify dashboard or server,
# then fill in the real values for each variable.
# ═══════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────
POSTGRES_USER="falz"
POSTGRES_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
POSTGRES_DB="falz_prod"
DATABASE_URL="postgresql://falz:CHANGE_ME_STRONG_PASSWORD@db:5432/falz_prod?schema=public"

# ── NextAuth ───────────────────────────────────────────────────
NEXTAUTH_SECRET="CHANGE_ME_RANDOM_SECRET_32_CHARS_MIN"
NEXTAUTH_URL="https://your-domain.com"

# ── Application ────────────────────────────────────────────────
APP_URL="https://your-domain.com"
APP_NAME="FALZ"
APP_PORT=3000

# ── Storage (S3 / MinIO) ──────────────────────────────────────
STORAGE_PROVIDER="s3"
S3_BUCKET="falz-media"
S3_REGION="me-south-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""

# ── Email (SMTP) ───────────────────────────────────────────────
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@falz.sa"

# ── Billing (Moyasar / Stripe) ────────────────────────────────
BILLING_PROVIDER="mock"
MOYASAR_API_KEY=""
MOYASAR_PUBLISHABLE_KEY=""
